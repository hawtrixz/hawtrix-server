# =====================================================
# Hawtrix Server — Configuration
# Copiez ce fichier en .env et remplissez les valeurs
# =====================================================

# Port du serveur (garder tel quel en déploiement : Render fournit PORT automatiquement)
PORT=3000

# Clé secrète pour les jetons JWT — INVENTEZ UNE LONGUE CHAÎNE ALÉATOIRE
# Exemple de génération : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=votre_cle_secrete_aleatoire_tres_longue_ici

# Jeton admin — permet d'accéder aux routes /admin/*
# Envoyez-le dans l'en-tête : Authorization: Bearer ADMIN_xxx
ADMIN_SECRET_TOKEN=changez_moi_aussi_123456

# Origines autorisées (laisser * pour commencer, puis restreindre en production)
CORS_ORIGIN=*
